{
  "name": "nortezh-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Nortezh user API, generated from its OpenAPI spec",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "nortezh-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "sync-spec": "tsx scripts/sync-spec.ts",
    "generate": "tsx scripts/generate.ts",
    "build": "npm run generate && tsc && tsx scripts/stamp.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "tsx --test test/*.test.ts",
    "check": "tsx scripts/check-generated.ts && tsx scripts/check-dist.ts && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nortezh/nortezh-mcp.git"
  }
}
